{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>thegeeklab/renovate-presets"],
  "postUpdateOptions": ["npmInstallTwice"],
  "customManagers": [
    {
      "description": "Update engines.vscode in sync with @types/vscode",
      "customType": "regex",
      "managerFilePatterns": ["package.json"],
      "matchStrings": [
        "\"engines\":\\s*\\{[\\s\\S]*?\"vscode\":\\s*\"\\^(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "@types/vscode"
    }
  ],
  "packageRules": [
    {
      "description": "Group @types/vscode and engines.vscode updates",
      "matchPackageNames": ["@types/vscode"],
      "groupName": "vscode engine and types"
    },
    {
      "description": "Group vscode-languageserver-node monorepo packages into one",
      "matchPackageNames": [
        "vscode-jsonrpc",
        "vscode-languageclient",
        "vscode-languageserver",
        "vscode-languageserver-protocol",
        "vscode-languageserver-textdocument",
        "vscode-languageserver-types",
        "vscode-json-languageservice"
      ],
      "groupName": "vscode-languageserver-node monorepo"
    }
  ]
}
