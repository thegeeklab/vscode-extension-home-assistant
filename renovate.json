{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>thegeeklab/renovate-presets"],
  "postUpdateOptions": ["npmInstallTwice"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^scripts/schema/frontend\\.ts$"],
      "matchStrings": [
        "FRONTEND_REF\\s*=\\s*process\\.env\\.FRONTEND_REF\\s*\\?\\?\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "home-assistant/frontend",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "regex:^(?<major>\\d{8})\\.(?<build>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Group vscode-languageserver-node monorepo packages into one",
      "matchPackageNames": [
        "vscode-jsonrpc",
        "vscode-languageclient",
        "vscode-languageserver",
        "vscode-languageserver-protocol",
        "vscode-languageserver-textdocument",
        "vscode-languageserver-types",
        "vscode-json-languageservice"
      ],
      "groupName": "vscode-languageserver-node monorepo",
      "separateMajorMinor": false
    },
    {
      "matchPackageNames": ["@types/vscode"],
      "enabled": false
    },
    {
      "description": "Pin the home-assistant/frontend release used for Lovelace schema generation",
      "matchPackageNames": ["home-assistant/frontend"],
      "groupName": "home-assistant frontend",
      "separateMajorMinor": false
    }
  ]
}
