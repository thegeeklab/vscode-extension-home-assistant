{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "lib": ["ES2024"],
    "outDir": "out",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "ignoreDeprecations": "6.0",
    "types": ["node", "mocha"],
    "paths": {
      "vscode-languageclient/node": ["./node_modules/vscode-languageclient/lib/node/main.d.ts"],
      "vscode-languageserver/node": ["./node_modules/vscode-languageserver/lib/node/main.d.ts"],
      "vscode-languageserver-protocol/node": [
        "./node_modules/vscode-languageserver-protocol/lib/node/main.d.ts"
      ]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.json", "test/**/*.ts", "test/**/*.json"],
  "exclude": ["node_modules", "out", "dist", ".vscode-test"]
}
