  "scripts": {
    "check-types": "tsc --noEmit",
    "check-types:watch": "tsc --noEmit --watch",
    "schema": "ts-node src/language-service/src/schemas/generateSchemas.ts",
    "build": "npm run check-types && node esbuild.js",
    "build:watch": "node esbuild.js --watch",
    "build:prod": "npm run check-types && node esbuild.js --production",
    "build:test": "npm run schema && tsc -p ./",
    "build:test:watch": "tsc -p ./ --watch",
    "build:all": "run-p build build:test",
    "build:all:watch": "run-p build:watch build:test:watch",
    "vscode:prepublish": "npm run build:prod && npm run build:test",
    "package:local": "npm run vscode:prepublish && npx vsce package --no-git-tag-version",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spell": "cspell \"**\"",
    "pretest": "npm run build:all",
    "test": "node ./out/test/runTest.js"
  },
